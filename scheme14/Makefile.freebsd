# scheme14 — FreeBSD でのビルド。
#
#     make -C scheme14 -f Makefile.freebsd
#
# `make -C scheme14` だけだと scheme14/Makefile が Makefile.linux を読む。
# Boost の場所が FreeBSD と違うので、こちらを -f で指定する。
# 実行ファイルは scheme14（拡張子なし）。
#
# フラグはリポジトリ直下の Makefile.freebsd と同じ:
#   clang++、/usr/local の Boehm GC、Boost ヘッダは /usr/local/include/boost。
# BSD make で読めるように、GNU make だけの関数は使わない。

CXX = clang++

CXXFLAGS = -std=c++17 -Wall -Wextra -O2 -Wno-unused-function

GC_INCLUDE = -I/usr/local/include

BOOST_INCLUDE = -I/usr/local/include/boost

GC_LIB = -L/usr/local/lib -lgc -lgccpp

TARGET = scheme14
SOURCE = scheme14.cpp

.PHONY: all clean selftest compare test sicp bench help

all: $(TARGET)

$(TARGET): $(SOURCE)
	$(CXX) $(CXXFLAGS) $(GC_INCLUDE) $(BOOST_INCLUDE) -o $@ $< $(GC_LIB)

# 凍結仕様（dev_memo.md §2）との突き合わせ。エラー本文と位置もここで見る。
selftest: $(TARGET)
	./$(TARGET) --selftest

# 構文展開が scheme12 と等価かを突き合わせる。scheme12_debug のビルドが要る
# （リポジトリのルートで make -f Makefile.freebsd scheme12）。
compare: $(TARGET)
	cd .. && ./scheme14/tests/compare_expand.sh ./scheme14/$(TARGET)

# 既存 .scm 資産との互換性回帰（受け入れ基準そのもの）。
test: $(TARGET)
	cd .. && ./scheme14/tests/run_golden.sh ./scheme14/$(TARGET)

sicp: $(TARGET)
	cd .. && ./scheme14/sicp/run_sicp.sh ./scheme14/$(TARGET)

# 呼び出し性能のベンチ。time は FreeBSD の sh の予約語。
bench: $(TARGET)
	cd .. && printf '(define (loop i acc) (if (= i 0) acc (loop (- i 1) (+ acc 1))))\n(display (loop 1000000 0))\n(newline)\n' > scheme14/.bench.scm
	cd .. && time ./scheme14/$(TARGET) --load scheme14/.bench.scm
	rm -f .bench.scm

clean:
	rm -f $(TARGET) .bench.scm

help:
	@echo "scheme14 targets (FreeBSD):"
	@echo "  all      - ビルド（scheme14）"
	@echo "  selftest - 凍結仕様との突き合わせ（C++ 単体の回帰）"
	@echo "  compare  - 構文展開が scheme12 と等価かを突き合わせる"
	@echo "  test     - 互換性回帰 + エラーの包み + REPL の筋道（受け入れ基準）"
	@echo "  sicp     - SICP を教材にした回帰"
	@echo "  bench    - 呼び出し性能のベンチ"
	@echo "  clean    - 生成物を削除"
	@echo "使い方: make -C scheme14 -f Makefile.freebsd"
